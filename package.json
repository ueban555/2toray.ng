{
  "name": "vpn-config-aggregator",
  "version": "1.0.0",
  "description": "Автоматический сборщик и агрегатор VPN-конфигов с web-интерфейсом",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "build": "npm run test && npm run start",
    "daemon": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop vpn-aggregator",
    "restart": "pm2 restart vpn-aggregator",
    "logs": "pm2 logs vpn-aggregator"
  },
  "keywords": [
    "vpn",
    "clash",
    "v2ray",
    "trojan",
    "hysteria",
    "reality",
    "aggregator",
    "proxy"
  ],
  "author": "VPN Config Aggregator",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.2",
    "yaml": "^2.3.4",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0",
    "fs-extra": "^11.2.0",
    "cheerio": "^1.0.0-rc.12",
    "ping": "^0.4.4",
    "socket.io": "^4.7.4",
    "crypto": "^1.0.1",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "multer": "^1.4.5-lts.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "rate-limiter-flexible": "^4.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "pm2": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}